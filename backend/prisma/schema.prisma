generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── MODELOS DE USUARIO ────────────────────────────────────────────────────────

model User {
  id           Int             @id @default(autoincrement())
  name         String
  email        String          @unique
  password     String
  role         Role            @default(MEMBER)
  avatarColor  String?         @default("#4f46e5")
  avatarUrl    String?         
  createdAt    DateTime        @default(now())

  // Relaciones existentes
  sessions     AuthSession[]
  projects     ProjectMember[]
  tasks        Task[]          // Tareas asignadas a este usuario

  // NUEVAS Relaciones para v2.0 (Requeridas por Prisma)
  comments     Comment[]
  activityLogs ActivityLog[]
  attachments  Attachment[]

  @@map("users")
}

// ── MODELOS DE PROYECTO ──────────────────────────────────────────────────────

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members     ProjectMember[]
  tasks       Task[]
  
  // Relación con Logs (Para ver actividad por proyecto)
  activityLogs ActivityLog[]

  @@map("projects")
}

model ProjectMember {
  userId         Int
  projectId      Int
  role           ProjectMemberRole @default(MEMBER)
  joinedAt       DateTime          @default(now())
  canCreateTasks Boolean           @default(false)
  canEditTasks   Boolean           @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_members")
}

// ── MODELOS DE TAREAS Y COLABORACIÓN ─────────────────────────────────────────

model Task {
  version     Int        @default(1)
  assignmentVersion Int @default(0)
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId   Int
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assigneeId  Int?
  assignee    User?      @relation(fields: [assigneeId], references: [id])

  // NUEVAS Relaciones para v2.0
  comments    Comment[]
  attachments Attachment[]
  activityLogs ActivityLog[] // Para registrar cambios específicos de esta tarea

  @@map("tasks")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model ActivityLog {
  previousVersion Int?
  resultingVersion Int?
  changes Json?
  actorName String?
  reason String?
  id          Int      @id @default(autoincrement())
  type        String   // TASK_CREATED, TASK_COMPLETED, etc.
  description String
  createdAt   DateTime @default(now())

  // Campos informativos (Snapshot para evitar joins pesados si se desea)
  taskTitle    String?
  taskStatus   String?
  taskPriority String?
  projectName  String?

  // Relaciones
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  taskId      Int?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt, id])
  @@map("activity_logs")
}

model Attachment {
  id        Int      @id @default(autoincrement())
  url       String   // URL de Cloudinary
  name      String   // Nombre del archivo
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  @@map("attachments")
}

// ── ENUMS ────────────────────────────────────────────────────────────────────

enum ProjectMemberRole {
  OWNER
  MEMBER
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @db.Uuid
  session     AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash   String      @unique @db.Char(64)
  createdAt   DateTime    @default(now())
  consumedAt  DateTime?

  @@index([sessionId])
  @@map("refresh_tokens")
}

model NotificationJob {
  id String @id @default(uuid()) @db.Uuid
  kind String
  taskId Int
  projectId Int
  recipientId Int
  assignmentVersion Int?
  dueDate DateTime?
  dedupeKey String @unique
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  claimToken String? @db.Uuid
  leaseUntil DateTime?
  sendingAt DateTime?
  acceptedAt DateTime?
  result String?
  diagnostic String?
  resolutionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt, id])
  @@map("notification_jobs")
}

model DemoSeed {
  id String @id
  createdAt DateTime @default(now())
  @@map("demo_seeds")
}
