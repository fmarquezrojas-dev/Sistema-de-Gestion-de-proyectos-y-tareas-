# Configuración de Base de Datos (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/project_manager"

# Seguridad y Autenticación (JWT)
# Recomendación: Usar strings aleatorios de 32+ caracteres en producción
JWT_SECRET=tu_secreto_para_access_token
JWT_REFRESH_SECRET=tu_secreto_para_refresh_token
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Integración con Cloudinary (Gestión de Assets)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Comunicación entre Microservicios
NOTIFICATION_SERVICE_URL=http://localhost:8000

# CORS (Seguridad de acceso desde el Frontend)
FRONTEND_URL=http://localhost:5173