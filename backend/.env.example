# Configuración de Base de Datos (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/project_manager"

# Autenticación: generar una clave aleatoria de al menos 32 bytes.
# Configurar JWT_SECRET en .env; no imprimirla ni versionarla.
JWT_SECRET=
JWT_ISSUER=synkro-api
JWT_AUDIENCE=synkro-web
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=604800
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Límites por IP y ventana, solo para una instancia.
AUTH_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_REFRESH_LIMIT=120
AUTH_PASSWORD_LIMIT=5

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Integración con Cloudinary (Gestión de Assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comunicación entre Microservicios

# Producción: NODE_ENV=production exige HTTPS en AUTH_ALLOWED_ORIGINS.
# Cookies host-only, Secure en producción, SameSite=Strict: despliegue same-site.
# Secreto independiente para el worker; mínimo 32 caracteres.
NOTIFICATION_INTERNAL_SECRET=
